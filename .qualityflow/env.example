# Environment variables the CNV QualityFlow configuration expects.
# Copy to your shell profile or an untracked .env and fill in your own paths.
#   set -a; source .env; set +a
#
# This file is gitignored on purpose: it is a local template, not repository
# content. Each variable points at a local checkout of the repository named
# beside it; leave one empty and the repo-aware steps fall back to their
# common-directory probe (~/src/<repo>, ~/projects/<repo>).
#
# Root layer (.qualityflow/repositories.yaml)
#
# SOURCE_REPO_PATH must point at a checkout of the QE test suite,
# openshift-virtualization-tests, on the branch you are planning against: it is
# where /generate-tests writes and where `uv run pytest` runs.
SOURCE_REPO_PATH=
# The design-docs repository: STP template, STP guide, testing-tier definitions
# and the review rules are read from here. A layer anywhere in this repository
# is only discovered when this checkout is resolvable.
OPENSHIFT_VIRTUALIZATION_TESTS_DESIGN_DOCS_REPO_PATH=
OPENSHIFT_PYTHON_WRAPPER_REPO_PATH=
OPENSHIFT_PYTHON_UTILITIES_REPO_PATH=
PYTHON_RRMNGMNT_REPO_PATH=

# Per-SIG context repositories - sig-infra
KUBEVIRT_REPO_PATH=
SSP_OPERATOR_REPO_PATH=
COMMON_INSTANCETYPES_REPO_PATH=
COMMON_TEMPLATES_REPO_PATH=

# sig-iuo
HCO_REPO_PATH=
VIRT_PLATFORM_AUTOPILOT_REPO_PATH=

# sig-network
KUBERNETES_NMSTATE_REPO_PATH=
SRIOV_NETWORK_OPERATOR_REPO_PATH=
OVN_KUBERNETES_REPO_PATH=

# sig-storage
CDI_REPO_PATH=
KUBEVIRT_VELERO_PLUGIN_REPO_PATH=
OADP_OPERATOR_REPO_PATH=
VM_FILE_RESTORE_OPERATOR_REPO_PATH=

# sig-virt
KUBEVIRT_MIGRATION_OPERATOR_REPO_PATH=
NODE_HEALTHCHECK_OPERATOR_REPO_PATH=
KUBEVIRT_PLUGIN_REPO_PATH=
KUBEVIRT_ENHANCEMENTS_REPO_PATH=

# Credentials - deliberately empty and never committed.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Root layer, commented out there until a layer references it.
# FORKLIFT_REPO_PATH=
